{
  "name": "releasecheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "fixtures/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @releasecheck/contracts && npm run build -w @releasecheck/db && npm run build -w @releasecheck/storage && npm run build -w @releasecheck/checks",
    "build:apps": "npm run build -w @releasecheck/api && npm run build -w @releasecheck/worker && npm run build -w @releasecheck/demo-site && npm run build -w @releasecheck/web",
    "build": "npm run build:packages && npm run build:apps",
    "typecheck": "npm run build && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "test:design": "node --env-file-if-exists=.env scripts/design-smoke.mjs",
    "design:assets": "node --env-file-if-exists=.env scripts/generate-design-assets.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:migrate": "node --env-file-if-exists=.env packages/db/dist/migrate-cli.js",
    "dev": "npm run build && concurrently --kill-others --names api,worker,fixture,web \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:fixture\" \"npm run dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.local apps/api/dist/main.js",
    "dev:worker": "node --env-file-if-exists=.env apps/worker/dist/main.js",
    "dev:fixture": "node --env-file-if-exists=.env fixtures/demo-site/dist/main.js",
    "dev:web": "npm run dev -w @releasecheck/web",
    "test:recovery-ui": "node --env-file-if-exists=.env scripts/recovery-smoke.mjs",
    "test:auth-ui": "node --env-file-if-exists=.env scripts/auth-smoke.mjs",
    "runner:build": "docker build -f docker/runner.Dockerfile -t releasecheck-runner:local .",
    "test:container": "node scripts/container-smoke.mjs",
    "test:container-worker": "vitest run --project container",
    "runner:reap": "node --env-file-if-exists=.env.runner apps/worker/dist/janitor-main.js --once",
    "runner:janitor": "node --env-file-if-exists=.env.runner apps/worker/dist/janitor-main.js",
    "runner:benchmark": "node scripts/benchmark-runner.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "globals": "^16.0.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
