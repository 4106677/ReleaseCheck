# Local development only. Never point this prototype at a production database.
NODE_ENV=development
DATABASE_URL=postgres://releasecheck:releasecheck@127.0.0.1:55432/releasecheck
API_PORT=3001
FIXTURE_PORT=4174
FIXTURE_ORIGIN=http://127.0.0.1:4174
ARTIFACT_DIR=.artifacts
PLAYWRIGHT_BROWSERS_PATH=.local/browsers
# Integration tests require their own disposable database; never the app database.
TEST_DATABASE_URL=postgres://releasecheck:releasecheck@127.0.0.1:55432/releasecheck_test
# Optional owner-only GitHub login (local HTTP development, not production).
AUTH_MODE=local
APP_ORIGIN=http://127.0.0.1:5173
# Set AUTH_MODE=session only after configuring all three values in ignored .env.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER_ID=
